  "accepted_paths": [
   "exchange (iryna+noa)",
   "paid_service (eva+tomas)",
   "hybrid (lina+marko)",
   "referral (hector+sofia, only after third-party consent)"
  ],
  "refusals": [
   "expired / invalid availability -> needs_information",
   "withdrawn consent -> consent_required",
   "one-way value -> insufficient_mutual_value or incompatible"
  ],
  "funnel_realism": [
   "2 profiles ghost",
   "4 profiles never give delayed feedback"
  ],
  "backward_compatibility": [
   "iryna and noa produce brief version 1 (no pilot modes)"
  ],
  "flagged_not_blocked": [
   "referral with third party not_consulted -> eligible with THIRD_PARTY_NOT_CONSULTED; blocking it is an open human decision"
  ]
 },
