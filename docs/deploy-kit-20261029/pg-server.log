	      or (p_payload->''proposalId''<>''null''::jsonb and coalesce(p_payload->>''proposalId'','''')!~''^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$'') then
