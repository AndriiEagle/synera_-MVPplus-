  "localAdapters": [
    {
      "file": "C:/sw/task1601-header-chrome.cjs",
      "sha256": "59595797b7519b9e5c0314859e89368e14584e22393ffa93b45fab54d3d86b07",
      "source": "// Local launch adapter only; CI still calls the unmodified Chromium entrypoint.\nconst { createRequire } = require('node:module');\nconst fromRepo = createRequire('C:/sw/synera-design/package.json');\nconst { chromium } = fromRepo('playwright');\nconst launch = chromium.launch.bind(chromium);\nchromium.launch = options => launch({ ...options, channel: 'chrome' });\n"
    },
    {
      "file": "C:/sw/task1601-header-reversal.cjs",
      "sha256": "02f50ad61e856d5b0ab25659988881d8515fe0a80cc16e58429e18e3b9635421",
      "source": "// Same final oracle, but serve the exact CSS from the requested base commit.\nrequire('./task1601-header-chrome.cjs');\nconst { createRequire } = require('node:module');\nconst { execFileSync } = require('node:child_process');\nconst fromRepo = createRequire('C:/sw/synera-design/package.json');\nconst { chromium } = fromRepo('playwright');\nconst css = execFileSync('git', ['-C', 'C:/sw/synera-design', 'show',\n  'ef39b7d48e875eb88871cc2cfabf91344f1c7875:web_launch/site-shell.css']);\nconst launch = chromium.launch.bind(chromium);\nchromium.launch = async options => {\n  const browser = await launch(options);\n  const newContext = browser.newContext.bind(browser);\n  browser.newContext = async options => {\n    const context = await newContext(options);\n    const newPage = context.newPage.bind(context);\n    context.newPage = async (...args) => {\n      const page = await newPage(...args);\n      await page.route('**/site-shell.css', route => route.fulfill({\n        contentType: 'text/css', body: css,\n      }));\n      return page;\n    };\n    return context;\n  };\n  return browser;\n};\n"
    },
    {
      "file": "C:/sw/task1601-pw-chrome.config.mjs",
      "sha256": "025b0c2cd3df0bbd1f65a37c48d372f86beba8328e124bd40bc490b2dac9618e",
      "source": "import base from './synera-design/playwright.config.mjs';\nexport default {\n  ...base,\n  testDir: 'C:/sw/synera-design/tests',\n  outputDir: 'C:/sw/task1601-e2e-results',\n  use: { ...base.use, channel: 'chrome' },\n};\n"
    }
  ],
